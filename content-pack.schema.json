{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-growth.local/content-pack.schema.json",
  "title": "Daily Growth Content Pack",
  "description": "Schema for additive content packs imported into the Daily Growth PWA.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pack", "lessons"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "color"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" },
        "position": { "type": "integer", "minimum": 1 },
        "sourceNote": { "type": "string" }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "summary", "action", "reflection"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "whyItMatters": { "type": "string" },
          "example": { "type": "string" },
          "action": { "type": "string", "minLength": 1 },
          "reflection": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
